rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.matches('(?i)^azibabbasi8787@gmail\\.com$'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'status']) &&
        data.keys().hasOnly(['uid', 'id', 'email', 'name', 'role', 'status', 'createdAt', 'updatedAt', 'notes', 'initialPassword']) &&
        data.uid is string && data.uid.size() <= 128 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.email is string && data.email.size() <= 256 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.role in ['admin', 'student'] &&
        data.status in ['active', 'blocked', 'revoked'] &&
        (!('initialPassword' in data) || (data.initialPassword is string && data.initialPassword.size() <= 100)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidLesson(data) {
      return data.keys().hasAll(['title', 'driveUrl', 'driveFileId', 'order', 'isPublished']) &&
        data.keys().hasOnly(['id', 'title', 'driveUrl', 'driveFileId', 'order', 'isPublished', 'description', 'duration', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.driveUrl is string && data.driveUrl.size() > 0 && data.driveUrl.size() <= 1000 &&
        data.driveFileId is string && data.driveFileId.size() > 0 && data.driveFileId.size() <= 128 &&
        data.order is number &&
        data.isPublished is bool &&
        (!('duration' in data) || (data.duration is string && data.duration.size() <= 50)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (isAdmin() || request.auth.uid == adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && (isAdmin() || (isBootstrappedAdmin() && request.auth.uid == adminId));
    }

    // Users collection (Students and Admins)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && (
        isAdmin() ||
        request.auth.uid == userId
      ) && isValidUser(incoming());
      allow update: if isValidId(userId) && isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) &&
          isValidUser(incoming())
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Course Lessons collection
    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && isSignedIn() && (isAdmin() || resource.data.isPublished == true);
      allow list: if isSignedIn() && (isAdmin() || resource.data.isPublished == true);
      allow create: if isValidId(lessonId) && isAdmin() && isValidLesson(incoming());
      allow update: if isValidId(lessonId) && isAdmin() && isValidLesson(incoming());
      allow delete: if isValidId(lessonId) && isAdmin();
    }
  }
}
